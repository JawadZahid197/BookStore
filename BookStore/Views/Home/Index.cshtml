
@model BookStore.ViewModels.HomeViewModel

<h1>Book Store</h1>

<div class="row">
    <div class="col-md-6">
        <h3>Add Book</h3>

        <form method="post" action="/Home/AddBook">
            <input type="text" name="title" placeholder="Book Title" class="form-control mb-2" required />

            <input type="number" name="price" placeholder="Price" class="form-control mb-2" step="0.01" required />

            <select name="authorId" class="form-control mb-2" required>
                @foreach (var author in Model.Authors)
                {
                    <option value="@author.Id">@author.Name</option>
                }
            </select>

            <button type="submit" class="btn btn-primary">Add Book</button>
        </form>
    </div>

    <div class="col-md-6">
        <h3>Add Author</h3>

        <form method="post" action="/Home/AddAuthor">
            <input type="text" name="name" placeholder="Author Name" class="form-control mb-2" required />

            <input type="text" name="country" placeholder="Country" class="form-control mb-2" required />

            <button type="submit" class="btn btn-success">Add Author</button>
        </form>
    </div>
</div>

<hr />

<h2>Available Books</h2>

<div class="book-container">
    @if (Model.Books.Count == 0)
    {
        <p>No books available</p>
    }
    else
    {
        @foreach (var book in Model.Books)
        {
            <div class="book-card">
                <h4>@book.Title</h4>
                <p>Author: @book.AuthorName</p>
                <p>Price: Rs. @book.Price</p>

                <form method="post" action="/Home/RemoveBook" onsubmit="return confirmRemove();">
                    <input type="hidden" name="id" value="@book.Id" />
                    <button type="submit" class="btn btn-danger">Remove</button>
                </form>
            </div>
        }
    }
</div>

@section Styles {
    <style>
        .book-container {
            display: flex;
            flex-wrap: wrap;
            gap: 20px;
        }

        .book-card {
            border: 1px solid #ccc;
            padding: 20px;
            margin: 10px 0;
            width: 250px;
            border-radius: 8px;
        }
    </style>
}

@section Scripts {
    <script>
        function confirmRemove() {
            return window.confirm("Remove this book?");
        }
    </script>
}
